# ---------------------------------------------------------------------------
# The quotes below are for this file only.
#
# dotenv strips them when it loads .env.local. The Vercel dashboard does NOT —
# it stores whatever you paste, verbatim. Pasting a quoted value there gives
# you a variable with a literal " on the end, and the failure is remote from
# the cause: a trailing quote on GOOGLE_CLIENT_ID makes Google answer
# "401 invalid_client — the OAuth client was not found", which reads like a
# deleted OAuth client rather than a paste artefact.
#
# Copy the value BETWEEN the quotes into any dashboard, never the quotes.
# ---------------------------------------------------------------------------

# --- Database (Neon) -------------------------------------------------------
# Neon dashboard > your project > Connection string (pooled).
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/marginalia?sslmode=require"

# --- Auth (Better Auth) ----------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# The origin Better Auth builds its OAuth redirect URI from. It must match the
# authorised redirect URI in Google Cloud exactly, including scheme and port.
#
# This localhost value is for local development ONLY. Each deployed environment
# needs its own — a Vercel deployment still carrying "http://localhost:3000"
# will send users to localhost after Google authenticates them, and Google will
# refuse the redirect_uri before that anyway. Set it per environment, and
# register each origin's /api/auth/callback/google in Google Cloud.
BETTER_AUTH_URL="http://localhost:3000"

# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID.
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Book data -------------------------------------------------------------
# Optional. Open Library needs no key; this is only for the enrichment
# fallback. Without it, enrichment is skipped and the app still works.
GOOGLE_BOOKS_API_KEY=""

# --- Invitations -----------------------------------------------------------
# Who may mint invite codes. One address or several, comma separated. Unset
# means nobody can — a misconfigured deployment closes the door rather than
# opening it to every member.
MARGINALIA_OWNER_EMAIL=""
