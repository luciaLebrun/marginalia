# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Claude Code: the shared config IS committed on purpose (CLAUDE.md,
# .claude/skills, .claude/agents, .claude/settings.json) — it is project
# documentation. These two are per-machine and must not be:
#   settings.local.json accumulates permissions approved on one developer's
#   machine, and config.local.json is Impeccable's per-machine override.
.claude/settings.local.json
.impeccable/config.local.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Impeccable: the decision-round server log is per-session noise.
.impeccable/questions/

# Local screenshots from `pnpm shot`.
.screenshots/

# Playwright
/test-results/
/playwright-report/
/blob-report/
