{
  "name": "marginalia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "smoke:books": "node --experimental-strip-types scripts/smoke-books.mts",
    "test:integration": "vitest run src/lib/invite.integration.test.ts",
    "seed:dev": "node --env-file=.env.local --experimental-strip-types scripts/seed-dev.mts",
    "shot": "node scripts/screenshot.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.3",
    "@neondatabase/serverless": "^1.1.0",
    "better-auth": "^1.7.3",
    "drizzle-orm": "^0.45.2",
    "jpeg-js": "^0.4.4",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/jpeg-js": "^0.3.7",
    "@types/node": "^22.20.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.5.0",
  "description": "A reading diary — log, rate and review the books you read.",
  "pnpm": {
    "overrides": {
      "@esbuild-kit/esm-loader": "npm:tsx@^4.23.13",
      "@esbuild-kit/core-utils": "npm:tsx@^4.23.13"
    }
  }
}
