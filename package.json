{
  "name": "marginalia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:studio:preview": "node --env-file=.env.preview node_modules/drizzle-kit/bin.cjs studio",
    "db:studio:prod": "node --env-file=.env.production node_modules/drizzle-kit/bin.cjs studio",
    "db:push": "drizzle-kit push",
    "smoke:books": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/smoke-books.mts",
    "test:integration": "vitest run src/**/*.integration.test.ts",
    "backfill:categories": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/backfill-categories.mts",
    "seed:dev": "node --env-file=.env.local --experimental-strip-types scripts/seed-dev.mts",
    "shot": "node scripts/screenshot.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.5",
    "@neondatabase/serverless": "^1.1.0",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.3",
    "jpeg-js": "^0.4.4",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.1",
    "dotenv": "^18.0.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@10.5.0",
  "description": "A reading diary — log, rate and review the books you read.",
  "pnpm": {
    "overrides": {
      "@esbuild-kit/esm-loader": "npm:tsx@^4.23.13",
      "@esbuild-kit/core-utils": "npm:tsx@^4.23.13"
    }
  }
}
